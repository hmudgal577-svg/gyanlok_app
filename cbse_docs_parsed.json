{
  "cbse_syllabus_html": "\n    <div class=\"cbse-docx-render\" style=\"font-family: 'Plus Jakarta Sans', 'Noto Sans Devanagari', 'Inter', sans-serif; color: #0F172A; max-width: 900px; margin: 0 auto; line-height: 1.6;\">\n      <div style=\"background: linear-gradient(135deg, #156082 0%, #0D4763 100%); color: #FFFFFF; padding: 1.5rem; border-radius: 12px; margin-bottom: 1.5rem; box-shadow: 0 4px 14px rgba(21, 96, 130, 0.2);\">\n        <div style=\"display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap;\">\n          <span style=\"background: rgba(255,255,255,0.2); font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 20px; text-transform: uppercase;\">CBSE OFFICIAL 2026-27</span>\n          <span style=\"background: #EBF3FD; color: #156082; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 20px;\">कोर्स कोड: 085</span>\n        </div>\n        <h2 style=\"font-size: 1.4rem; font-weight: 800; margin: 0 0 6px; color:#FFFFFF;\">सीबीएसई कक्षा 10 हिंदी (कोर्स बी) - संपूर्ण आधिकारिक पाठ्यक्रम</h2>\n        <p style=\"font-size: 0.9rem; opacity: 0.9; margin: 0;\">केन्द्रीय माध्यमिक शिक्षा बोर्ड द्वारा निर्धारित वार्षिक परीक्षा पाठ्यक्रम, पुस्तक वार विवरण एवं अंक भार</p>\n      </div>\n    \n\n                    <div style=\"background: #EBF3FD; border-left: 5px solid #156082; border-radius: 8px; padding: 1rem 1.25rem; margin: 1.5rem 0 1rem;\">\n                      <h3 style=\"margin: 0; color: #156082; font-size: 1.15rem; font-weight: 800;\">पाठ्यपुस्तक एवं पूरक पाठ्यपुस्तक-28 अंक</h3>\n                    </div>\n                    \n\n                    <div style=\"background: #EBF3FD; border-left: 5px solid #156082; border-radius: 8px; padding: 1rem 1.25rem; margin: 1.5rem 0 1rem;\">\n                      <h3 style=\"margin: 0; color: #156082; font-size: 1.15rem; font-weight: 800;\">CBSE कक्षा 10 हिन्दी B के पाठ्यक्रम में स्पर्श भाग–2 और संचयन भाग–2 पुस्तकें शामिल हैं |</h3>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>स्पर्श भाग–2 में निम्नलिखित अध्याय शामिल हैं :-</span>\n                    </div>\n                    \n\n                    <h4 style=\"color: #0F172A; font-size: 1.05rem; font-weight: 700; margin: 1.25rem 0 0.5rem; padding-bottom: 4px; border-bottom: 2px solid #E2E8F0;\">\n                      <span style=\"color: #156082; margin-right: 6px;\">📖</span> गद्य खंड\n                    </h4>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>बड़े भाई साहब — प्रेमचंद</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>डायरी का एक पन्ना — सीताराम सेकसरिया</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>तताँरा-वामीरो कथा — लीलाधर मंडलोई</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>तीसरी कसम के शिल्पकार शैलेंद्र — प्रहलाद अग्रवाल</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>अब कहाँ दूसरे के दुख से दुखी होने वाले — निदा फ़ाज़ली</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>पतझड़ में टूटी पत्तियाँ — रवींद्र केलेकर</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>कारतूस — हबीब तनवीर</span>\n                    </div>\n                    \n\n                    <h4 style=\"color: #0F172A; font-size: 1.05rem; font-weight: 700; margin: 1.25rem 0 0.5rem; padding-bottom: 4px; border-bottom: 2px solid #E2E8F0;\">\n                      <span style=\"color: #156082; margin-right: 6px;\">📖</span> काव्य खंड\n                    </h4>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>कबीर — साखी</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>मीरा – पद</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>मनुष्यता — मैथिलीशरण गुप्त</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>पर्वत प्रदेश में पावस — सुमित्रानंदन पंत</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>तोप — वीरेन डंगवाल</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>कर चले हम फ़िदा — कैफ़ी आज़मी</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>आत्मत्राण — रवींद्रनाथ ठाकुर</span>\n                    </div>\n                    \n\n                    <h4 style=\"color: #0F172A; font-size: 1.05rem; font-weight: 700; margin: 1.25rem 0 0.5rem; padding-bottom: 4px; border-bottom: 2px solid #E2E8F0;\">\n                      <span style=\"color: #156082; margin-right: 6px;\">📖</span> पूरक पाठ्यपुस्तक — संचयन भाग–2 में निम्नलिखित अध्याय शामिल हैं :-\n                    </h4>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>हरिहर काका — मिथिलेश्वर</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>टोपी शुक्ला — राही मासूम रज़ा</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>सपनों के-से दिन — गुरदयाल सिंह</span>\n                    </div>\n                    \n\n                    <div style=\"background: #EBF3FD; border-left: 5px solid #156082; border-radius: 8px; padding: 1rem 1.25rem; margin: 1.5rem 0 1rem;\">\n                      <h3 style=\"margin: 0; color: #156082; font-size: 1.15rem; font-weight: 800;\">व्यावहारिक व्याकरण — 16 अंक</h3>\n                    </div>\n                    \n\n                    <h4 style=\"color: #0F172A; font-size: 1.05rem; font-weight: 700; margin: 1.25rem 0 0.5rem; padding-bottom: 4px; border-bottom: 2px solid #E2E8F0;\">\n                      <span style=\"color: #156082; margin-right: 6px;\">📖</span> 1. पदबंध — 4 अंक\n                    </h4>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>विद्यार्थियों को निम्नलिखित पदबंधों की पहचान एवं प्रयोग का अभ्यास करना चाहिए:</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>संज्ञा पदबंध</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>सर्वनाम पदबंध</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>विशेषण पदबंध</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>क्रिया पदबंध</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>क्रियाविशेषण पदबंध</span>\n                    </div>\n                    \n\n                    <h4 style=\"color: #0F172A; font-size: 1.05rem; font-weight: 700; margin: 1.25rem 0 0.5rem; padding-bottom: 4px; border-bottom: 2px solid #E2E8F0;\">\n                      <span style=\"color: #156082; margin-right: 6px;\">📖</span> 2. रचना के आधार पर वाक्य रूपांतरण — 4 अंक\n                    </h4>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>दिए गए वाक्यों के बीच रूपांतरण का अभ्यास।</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>सरल वाक्य</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>संयुक्त वाक्य</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>मिश्र वाक्य</span>\n                    </div>\n                    \n\n                    <h4 style=\"color: #0F172A; font-size: 1.05rem; font-weight: 700; margin: 1.25rem 0 0.5rem; padding-bottom: 4px; border-bottom: 2px solid #E2E8F0;\">\n                      <span style=\"color: #156082; margin-right: 6px;\">📖</span> 3. समास — 4 अंक\n                    </h4>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>निम्नलिखित समासों की पहचान, विग्रह आदि का अभ्यास:</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>अव्ययीभाव समास</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>तत्पुरुष समास</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>द्वंद्व समास</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>बहुव्रीहि समास</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>कर्मधारय समास</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>द्विगु समास</span>\n                    </div>\n                    \n\n                    <h4 style=\"color: #0F172A; font-size: 1.05rem; font-weight: 700; margin: 1.25rem 0 0.5rem; padding-bottom: 4px; border-bottom: 2px solid #E2E8F0;\">\n                      <span style=\"color: #156082; margin-right: 6px;\">📖</span> 4. मुहावरे — 4 अंक\n                    </h4>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>मुहावरे का अर्थ</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>वाक्य में प्रयोग</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>संदर्भानुसार उपयुक्त मुहावरे का चयन</span>\n                    </div>\n                    \n\n                    <div style=\"background: #EBF3FD; border-left: 5px solid #156082; border-radius: 8px; padding: 1rem 1.25rem; margin: 1.5rem 0 1rem;\">\n                      <h3 style=\"margin: 0; color: #156082; font-size: 1.15rem; font-weight: 800;\">रचनात्मक लेखन — 22 अंक</h3>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>अनुच्छेद लेखन</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>औपचारिक पत्र लेखन</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>सूचना लेखन</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>विज्ञापन लेखन</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>ई-मेल/लघुकथा लेखन</span>\n                    </div>\n                    \n\n                    <div style=\"padding: 6px 12px; margin: 3px 0; font-size: 0.94rem; color: #334155; background: #F8FAFC; border-radius: 6px; border: 1px solid #F1F5F9; display: flex; align-items: center; justify-content: space-between;\">\n                      <span>चित्र/विषय आधारित लेखन</span>\n                    </div>\n                    \n</div>",
  "cbse_marking_scheme_html": "\n    <div class=\"cbse-docx-render\" style=\"font-family: 'Plus Jakarta Sans', 'Noto Sans Devanagari', 'Inter', sans-serif; color: #0F172A; max-width: 900px; margin: 0 auto; line-height: 1.6;\">\n      <div style=\"background: linear-gradient(135deg, #156082 0%, #0D4763 100%); color: #FFFFFF; padding: 1.5rem; border-radius: 12px; margin-bottom: 1.5rem; box-shadow: 0 4px 14px rgba(21, 96, 130, 0.2);\">\n        <div style=\"display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap;\">\n          <span style=\"background: rgba(255,255,255,0.2); font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 20px; text-transform: uppercase;\">BLUEPRINT & SCHEME</span>\n          <span style=\"background: #EBF3FD; color: #156082; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 20px;\">कुल अंक: 80 + 20</span>\n        </div>\n        <h2 style=\"font-size: 1.4rem; font-weight: 800; margin: 0 0 6px; color:#FFFFFF;\">सीबीएसई कक्षा 10 हिंदी (कोर्ष बी) - अंक योजना व प्रश्न-पत्र प्रारूप (2026-27)</h2>\n        <p style=\"font-size: 0.9rem; opacity: 0.9; margin: 0;\">खंड-वार प्रश्न प्रकार, विकल्प वितरण, शब्द सीमा एवं सटीक अंक विभाजन गाइड</p>\n      </div>\n    \n\n                    <div style=\"background: #EBF3FD; border-left: 5px solid #156082; border-radius: 8px; padding: 0.85rem 1.15rem; margin: 1.4rem 0 0.85rem;\">\n                      <h3 style=\"margin: 0; color: #156082; font-size: 1.1rem; font-weight: 800;\">CBSE Class 10 Hindi Course B (085)वार्षिक परीक्षा (2026 –27): प्रश्नपत्र का भार-विभाजननिर्धारित समय --3 घंटे</h3>\n                    </div>\n                    \n<div style=\"overflow-x:auto; margin:1rem 0 1.5rem;\"><table style=\"width:100%; border-collapse:collapse; border:1px solid #BAE6FD; border-radius:10px; overflow:hidden; box-shadow:0 2px 8px rgba(15,23,42,0.04);\">\n<tr style=\"background:#156082; border-bottom:1px solid #E2E8F0;\">\n<th style=\"padding:12px 14p